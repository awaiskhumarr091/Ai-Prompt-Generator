# LOCAL DEVELOPMENT ONLY.
# Copy this file to .env and fill in your key, then run: npm start
#
# For Vercel, do NOT upload this file. Set the key in the dashboard:
#   Settings -> Environment Variables -> ANTHROPIC_API_KEY

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional
PORT=3000
MODEL=claude-sonnet-4-6
